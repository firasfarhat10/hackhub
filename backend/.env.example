# --- Serveur ---
PORT=3000
NODE_ENV=development
# URL(s) du front autorisées par CORS, séparées par des virgules
CLIENT_URL=http://localhost:5173
 
# --- Base de données ---
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@cluster0.xxxxx.mongodb.net/hackhub?retryWrites=true&w=majority
 
# --- Authentification ---
JWT_SECRET=<longue_chaine_aleatoire>
JWT_EXPIRES_IN=1d
 
# --- IA (Google Gemini) : laisser GEMINI_API_KEY vide = mode dégradé sans IA ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_MS=10000
# Poids de la similarité dans le score de matching (le reste = complémentarité)
MATCH_WEIGHT_SIMILARITY=0.6
 
# --- Données de démonstration (npm run seed) ---
SEED_ADMIN_EMAIL=admin@hackhub.tn
SEED_ADMIN_PASSWORD=Admin2026!
